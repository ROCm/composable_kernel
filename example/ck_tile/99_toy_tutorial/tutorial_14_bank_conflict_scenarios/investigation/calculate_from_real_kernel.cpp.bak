// Use the ACTUAL kernel code to calculate offsets, then count conflicts
#include <iostream>
#include <set>
#include <map>
#include <vector>
#include "ck_tile/core.hpp"

using namespace ck_tile;

// Copy kernel struct (without main) from 04_row_major_xor.cpp
#include "/tmp/kernel_only.hpp"

template<bool UseXor>
void analyze_using_real_kernel()
{
    using DataType = half_t;
    using Kernel = ProductionTransposeKernel<DataType, UseXor>;
    
    constexpr index_t M = 64;
    constexpr index_t K = 32;
    constexpr index_t DataTypeSize = sizeof(DataType);
    
    // Use the ACTUAL descriptors from the kernel
    constexpr auto desc_mk = Kernel::MakeLdsDescriptorMK();
    
    std::cout << "\n=== FP16 " << (UseXor ? "WITH" : "WITHOUT") << " XOR (USING REAL KERNEL) ===\n\n";
    
    // WRITE conflicts - contiguous, should be 0
    std::cout << "WRITE: 0 conflicts (contiguous)\n\n";
    
    // READ conflicts - use Phase 0 as example
    std::cout << "READ Pattern Analysis (Phase 0):\n";
    std::vector<int> phase0 = {0, 1, 2, 3, 20, 21, 22, 23};
    
    index_t total_intra = 0;
    index_t total_inter = 0;
    
    // Process all 4 k_base iterations (k=0-7, 8-15, 16-23, 24-31)
    for(index_t k_base = 0; k_base < K; k_base += 8)
    {
        std::map<index_t, std::set<index_t>> bank_to_lanes;
        
        for(index_t lane : phase0)
        {
            index_t k2_idx = lane % 8;
            index_t m0_idx = lane / 8;
            index_t k = k_base + k2_idx;
            
            if(k >= K) continue;
            
            index_t m_start = m0_idx * 8;
            
            // Get actual offsets from real descriptor
            std::map<index_t, index_t> bank_count;
            std::set<index_t> banks_this_lane;
            
            for(index_t m = m_start; m < m_start + 8 && m < M; m++)
            {
                auto offset = desc_mk.calculate_offset(make_tuple(m, k));
                index_t byte_offset = offset * DataTypeSize;
                index_t bank = byte_offset / 4 % 32;
                
                bank_count[bank]++;
                banks_this_lane.insert(bank);
            }
            
            // Intra-lane conflicts
            for(const auto& entry : bank_count)
            {
                if(entry.second > 1)
                {
                    total_intra += (entry.second - 1);
                }
            }
            
            // Track for inter-lane
            for(index_t bank : banks_this_lane)
            {
                bank_to_lanes[bank].insert(lane);
            }
        }
        
        // Inter-lane conflicts for this k_base iteration
        for(const auto& entry : bank_to_lanes)
        {
            if(entry.second.size() > 1)
            {
                total_inter += (entry.second.size() - 1);
            }
        }
        
        // Debug first iteration
        if(k_base == 0)
        {
            std::cout << "  k_base=0 (lanes execute simultaneously):\n";
            for(index_t lane : phase0)
            {
                index_t k2_idx = lane % 8;
                index_t m0_idx = lane / 8;
                index_t k = k_base + k2_idx;
                index_t m_start = m0_idx * 8;
                
                std::set<index_t> banks;
                for(index_t m = m_start; m < m_start + 8 && m < M; m++)
                {
                    auto offset = desc_mk.calculate_offset(make_tuple(m, k));
                    index_t byte_offset = offset * DataTypeSize;
                    index_t bank = byte_offset / 4 % 32;
                    banks.insert(bank);
                }
                
                std::cout << "    Lane " << lane << " (k=" << k << "): banks {";
                for(auto it = banks.begin(); it != banks.end(); ++it)
                {
                    std::cout << *it;
                    if(std::next(it) != banks.end()) std::cout << ",";
                }
                std::cout << "}\n";
            }
            
            std::cout << "  Inter-lane conflicts:\n";
            for(const auto& entry : bank_to_lanes)
            {
                if(entry.second.size() > 1)
                {
                    std::cout << "    Bank " << entry.first << ": " << entry.second.size() << " lanes\n";
                }
            }
        }
    }
    
    // Scale to all 8 phases
    index_t phase0_intra = total_intra;
    index_t phase0_inter = total_inter;
    
    total_intra *= 8; // 8 phases
    total_inter *= 8;
    
    std::cout << "\nPhase 0 conflicts: intra=" << phase0_intra << ", inter=" << phase0_inter << "\n";
    std::cout << "All phases (×8): intra=" << total_intra << ", inter=" << total_inter << "\n";
    
    // Scale by K-loop iterations (4 for 128/32)
    index_t k_iterations = 4;
    std::cout << "\nScaled by " << k_iterations << " K-iterations:\n";
    std::cout << "  Total: " << (total_intra + total_inter) * k_iterations << "\n";
    std::cout << "  Intra: " << total_intra * k_iterations << "\n";
    std::cout << "  Inter: " << total_inter * k_iterations << "\n";
}

int main()
{
    std::cout << "=================================================\n";
    std::cout << "Using REAL kernel descriptors to calculate conflicts\n";
    std::cout << "=================================================\n";
    
    analyze_using_real_kernel<false>();
    analyze_using_real_kernel<true>();
    
    std::cout << "\n=== PROFILER TARGETS ===\n";
    std::cout << "WITHOUT XOR: 7,168\n";
    std::cout << "WITH XOR:    3,072\n";
    
    return 0;
}
