    auto x_len = x.get_lengths();

    (static_cast <bool> (k <= topk_src_len) ? void (0) : __assert_fail ("k <= topk_src_len", "/data0/aghamari/composable_kernel/include/ck_tile/host/reference/reference_topk.hpp", 49, __extension__ __PRETTY_FUNCTION__));
