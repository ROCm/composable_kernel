template <typename ADataType, typename BDataType>
struct RotatingMemWrapper
{
    RotatingMemWrapper() = delete;
    RotatingMemWrapper(const void* a_ptr_,
                       const void* b_ptr_,
                       std::size_t rotating_count_hint,
                       std::size_t size_a_,
                       std::size_t size_b_)
        : a_ptr(a_ptr_),
          b_ptr(b_ptr_),
          rotating_count(rotating_count_hint),
          size_a(size_a_),
          size_b(size_b_)
    {

        p_a_grids.push_back(a_ptr);
        p_b_grids.push_back(b_ptr);


        const uint64_t footprint = (size_a + size_b);
        const uint64_t max_rotating_count = (1ULL << 31) / footprint;
        rotating_count = std::min(rotating_count, max_rotating_count);


        for(size_t i = 1; i < rotating_count; i++)
        {
            {
                void* pADeviceBuf;
                do { hipError_t _tmpVal = hipMalloc(static_cast<void**>(&pADeviceBuf), size_a_); if(_tmpVal != hipSuccess) { std::ostringstream ostr; ostr << "HIP Function Failed (" << "/data0/aghamari/composable_kernel/include/ck_tile/host/rotating_buffers.hpp" << "," << 55 << ") " << hipGetErrorString(_tmpVal); throw std::runtime_error(ostr.str()); } } while(0);
                do { hipError_t _tmpVal = hipMemcpy(static_cast<void*>(pADeviceBuf), const_cast<void*>(p_a_grids[0]), size_a_, hipMemcpyDeviceToDevice); if(_tmpVal != hipSuccess) { std::ostringstream ostr; ostr << "HIP Function Failed (" << "/data0/aghamari/composable_kernel/include/ck_tile/host/rotating_buffers.hpp" << "," << 59 << ") " << hipGetErrorString(_tmpVal); throw std::runtime_error(ostr.str()); } } while(0);



                p_a_grids.push_back(pADeviceBuf);
            }

            {
                void* pBDeviceBuf;
                do { hipError_t _tmpVal = hipMalloc(static_cast<void**>(&pBDeviceBuf), size_b_); if(_tmpVal != hipSuccess) { std::ostringstream ostr; ostr << "HIP Function Failed (" << "/data0/aghamari/composable_kernel/include/ck_tile/host/rotating_buffers.hpp" << "," << 65 << ") " << hipGetErrorString(_tmpVal); throw std::runtime_error(ostr.str()); } } while(0);
                do { hipError_t _tmpVal = hipMemcpy(static_cast<void*>(pBDeviceBuf), const_cast<void*>(p_b_grids[0]), size_b_, hipMemcpyDeviceToDevice); if(_tmpVal != hipSuccess) { std::ostringstream ostr; ostr << "HIP Function Failed (" << "/data0/aghamari/composable_kernel/include/ck_tile/host/rotating_buffers.hpp" << "," << 69 << ") " << hipGetErrorString(_tmpVal); throw std::runtime_error(ostr.str()); } } while(0);



                p_b_grids.push_back(pBDeviceBuf);
            }
        }
    }


    void Next()
    {
        if(rotating_count > 1)
        {
            std::size_t idx = iter++ % rotating_count;
            a_ptr = p_a_grids[idx];
            b_ptr = p_b_grids[idx];
        }
    }
    void Print()
    {
        std::cout << "RotatingMemWrapper: { size_a: " << size_a << ", size_b: " << size_b
                  << ", rotating_count: " << rotating_count << "}" << std::endl;
    }

    ~RotatingMemWrapper() noexcept
    {
        if(rotating_count > 1)
        {

            a_ptr = p_a_grids[0];
            b_ptr = p_b_grids[0];


            for(size_t i = 1; i < rotating_count; i++)
            {
                ck_tile::hip_check_error(hipFree(const_cast<void*>(p_a_grids[i])));
                ck_tile::hip_check_error(hipFree(const_cast<void*>(p_b_grids[i])));
            }
        }
    }

    private:
    const void* a_ptr;
    const void* b_ptr;
    std::size_t iter = 0;
    std::size_t rotating_count = 1;
    std::size_t size_a = 0;
    std::size_t size_b = 0;
    std::vector<const void*> p_a_grids;
    std::vector<const void*> p_b_grids;
};
inline void flush_icache()
{
    hipDeviceProp_tR0600 deviceProps;
    do { hipError_t _tmpVal = hipGetDevicePropertiesR0600(&deviceProps, 0); if(_tmpVal != hipSuccess) { std::ostringstream ostr; ostr << "HIP Function Failed (" << "/data0/aghamari/composable_kernel/include/ck_tile/host/rotating_buffers.hpp" << "," << 121 << ") " << hipGetErrorString(_tmpVal); throw std::runtime_error(ostr.str()); } } while(0);




    constexpr int32_t blocks_per_cu = 60;
    int32_t gpu_block3 = deviceProps.multiProcessorCount * blocks_per_cu;

    ck_tile::flush_cache<<<dim3(gpu_block3), dim3(64), 0, nullptr>>>();
