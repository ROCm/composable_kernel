template <int MinBlockPerCu = 2,
          typename Arch = void,
          typename KernelImpl,
          typename... Args>
inline __attribute__((host)) auto
make_kernel(KernelImpl , dim3 grid_dim, dim3 block_dim, std::size_t lds_byte, Args... args)
{
    const auto kernel = []() {
        if constexpr(std::is_void_v<Arch>)
        {
            return kentry<MinBlockPerCu, KernelImpl, Args...>;
        }
        else
        {
            return kentry<Arch, MinBlockPerCu, KernelImpl, Args...>;
        }
    }();
    return [=](const stream_config& s) {
        kernel<<<grid_dim, block_dim, lds_byte, s.stream_id_>>>(args...);
    };
}

template <typename... Callables>
inline __attribute__((host)) void launch_and_check(const stream_config& sc, Callables&&... callables)
{

    if(!((static_cast<void>(callables(sc)), hipPeekAtLastError() == hipSuccess) && ...))
    {
        do { hipError_t _tmpVal = hipGetLastError(); if(_tmpVal != hipSuccess) { std::ostringstream ostr; ostr << "HIP Function Failed (" << "/data0/aghamari/composable_kernel/include/ck_tile/host/kernel_launch.hpp" << "," << 83 << ") " << hipGetErrorString(_tmpVal); throw std::runtime_error(ostr.str()); } } while(0);
    }
}


template <typename TimerType, typename PreprocessFunc>
inline __attribute__((host)) double
preprocess_profiling_impl(TimerType timer, const stream_config& s, PreprocessFunc preprocess)
{
    timer.start(s.stream_id_);
    for(int i = 0; i < s.nrepeat_; i++)
    {
        if constexpr(!std::is_same_v<PreprocessFunc, std::nullptr_t>)
        {
            preprocess();
        }
    }
    timer.stop(s.stream_id_);

    return timer.duration() / s.nrepeat_;
}

template <typename TimerType, typename CallablesFunc, typename PreprocessFunc = std::nullptr_t>
inline __attribute__((host)) double timing_loop_impl(TimerType timer,
                                     const stream_config& s,
                                     CallablesFunc&& callables_func,
                                     PreprocessFunc preprocess = nullptr)
{
    for(int i = 0; i < s.cold_niters_; i++)
    {
        callables_func();
    }

    auto preprocess_time = 0.0;
    if constexpr(!std::is_same_v<PreprocessFunc, std::nullptr_t>)
    {
        preprocess_time = preprocess_profiling_impl(gpu_timer{}, s, preprocess);
    }

    int i = 0;
    timer.start(s.stream_id_);
    while(i < s.nrepeat_)
    {
        if constexpr(!std::is_same_v<PreprocessFunc, std::nullptr_t>)
        {
            preprocess();
        }

        callables_func();
        i++;
    }
    timer.stop(s.stream_id_);

    if(!i)
        return 0.;
    return (timer.duration() / s.nrepeat_) - preprocess_time;
}
