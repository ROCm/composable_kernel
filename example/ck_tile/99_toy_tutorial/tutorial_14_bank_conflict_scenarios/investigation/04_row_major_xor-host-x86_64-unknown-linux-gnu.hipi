namespace ck_tile {


template <index_t MaxSize>
struct meta_data_buffer
{
    inline __attribute__((host)) __attribute__((device)) constexpr meta_data_buffer() : buffer_{}, size_{0} {}

    template <typename X, typename... Xs>
    inline __attribute__((host)) __attribute__((device)) constexpr meta_data_buffer(const X& x, const Xs&... xs)
        : buffer_{}, size_{0}
    {
        push(x, xs...);
    }

    template <typename T>
    inline __attribute__((host)) __attribute__((device)) constexpr void push(const T& data)
    {
        if constexpr(!std::is_empty_v<T>)
        {
            constexpr index_t size = sizeof(T);

            auto tmp = ck_tile::bit_cast<array<std::byte, size>>(data);

            for(int i = 0; i < size; i++)
            {
                buffer_(size_) = tmp[i];

                size_++;
            }
        }
    }

    template <typename X, typename... Xs>
    inline __attribute__((host)) __attribute__((device)) constexpr void push(const X& x, const Xs&... xs)
    {
        push(x);
        push(xs...);
    }

    template <typename T>
    inline __attribute__((host)) __attribute__((device)) constexpr T pop(index_t& pos) const
    {
        T data;

        if constexpr(!std::is_empty_v<T>)
        {
            constexpr index_t size = sizeof(T);

            array<std::byte, size> tmp;

            for(int i = 0; i < size; i++)
            {
                tmp(i) = buffer_[pos];

                pos++;
            }

            data = ck_tile::bit_cast<T>(tmp);
        }

        return data;
    }

    template <typename T>
    inline __attribute__((host)) __attribute__((device)) constexpr T get(index_t pos) const
    {
        constexpr index_t size = sizeof(T);

        array<std::byte, size> tmp;

        for(int i = 0; i < size; i++)
        {
            tmp(i) = buffer_[pos];

            pos++;
        }

        auto data = ck_tile::bit_cast<T>(tmp);

        return data;
    }


    array<std::byte, MaxSize> buffer_;
    index_t size_ = 0;
};

}
