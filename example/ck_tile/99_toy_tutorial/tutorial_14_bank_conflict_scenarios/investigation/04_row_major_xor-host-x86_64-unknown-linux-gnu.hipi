inline __attribute__((host)) __attribute__((device)) constexpr auto to_array(const std::vector<X>& x)
{
    array<T, N> arr;

    static_for<0, N, 1>{}([&x, &arr](auto i) { arr(i) = x[i]; });

    return arr;
}

