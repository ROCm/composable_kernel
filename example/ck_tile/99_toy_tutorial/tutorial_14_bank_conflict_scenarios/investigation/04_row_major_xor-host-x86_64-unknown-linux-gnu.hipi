struct waitcnt_arg
{
# 172 "/data0/aghamari/composable_kernel/include/ck_tile/core/arch/arch.hpp"
    inline __attribute__((device)) static constexpr index_t MAX = 0b11'00'1111'0'111'1111;

    inline __attribute__((device)) static constexpr index_t kMaxVmCnt = 0b111111;
    inline __attribute__((device)) static constexpr index_t kMaxExpCnt = 0b111;
    inline __attribute__((device)) static constexpr index_t kMaxLgkmCnt = 0b1111;

    template <index_t cnt>
    inline __attribute__((device)) static constexpr index_t from_vmcnt()
    {
        static_assert(cnt >= 0 && !(cnt >> 6), "valid range is [0..63]");
        return MAX & ((cnt & 0b1111) | ((cnt & 0b110000) << 10));
    }

    template <index_t cnt>
    inline __attribute__((device)) static constexpr index_t from_expcnt()
    {
        static_assert(cnt >= 0 && !(cnt >> 3), "valid range is [0..7]");
        return MAX & (cnt << 4);
    }

    template <index_t cnt>
    inline __attribute__((device)) static constexpr index_t from_lgkmcnt()
    {
        static_assert(cnt >= 0 && !(cnt >> 4), "valid range is [0..15]");
        return MAX & (cnt << 8);
    }

};

