inline __attribute__((device)) int clz(uint32_t x) { return __clz(x); }


inline __attribute__((host)) __attribute__((device)) constexpr index_t gcd(index_t x, index_t y)
{
    if(x < 0)
    {
        return gcd(-x, y);
    }
    else if(y < 0)
    {
        return gcd(x, -y);
    }
    else if(x == y || x == 0)
    {
        return y;
    }
    else if(y == 0)
    {
        return x;
    }
    else if(x > y)
    {
        return gcd(x % y, y);
    }
    else
    {
        return gcd(x, y % x);
    }
}

template <index_t X, index_t Y>
inline __attribute__((host)) __attribute__((device)) constexpr auto gcd(number<X>, number<Y>)
{
    constexpr auto r = gcd(X, Y);

    return number<r>{};
}

template <typename X,
          typename... Ys,
          typename std::enable_if<sizeof...(Ys) >= 2, bool>::type = false>
inline __attribute__((host)) __attribute__((device)) constexpr auto gcd(X x, Ys... ys)
{
    return gcd(x, gcd(ys...));
}


template <typename X, typename Y>
inline __attribute__((host)) __attribute__((device)) constexpr auto lcm(X x, Y y)
{
    return (x * y) / gcd(x, y);
}

template <typename X,
          typename... Ys,
          typename std::enable_if<sizeof...(Ys) >= 2, bool>::type = false>
inline __attribute__((host)) __attribute__((device)) constexpr auto lcm(X x, Ys... ys)
{
    return lcm(x, lcm(ys...));
}

