template<typename T_, index_t N_>
struct thread_buffer {
    using value_type = remove_cvref_t<T_>;
    static constexpr index_t N = N_;

    value_type data[N];


    inline __attribute__((host)) __attribute__((device)) constexpr thread_buffer() : data{} {}
    inline __attribute__((host)) __attribute__((device)) constexpr thread_buffer(const value_type & o) : data{} {
        static_for<0, N, 1>{}(
            [&](auto i) { data[i] = o; }
        );
    }

    inline __attribute__((host)) __attribute__((device)) static constexpr auto size() { return N; }
    inline __attribute__((host)) __attribute__((device)) auto & get() {return data; }
    inline __attribute__((host)) __attribute__((device)) const auto & get() const {return data; }
    inline __attribute__((host)) __attribute__((device)) auto & get(index_t i) {return data[i]; }
    inline __attribute__((host)) __attribute__((device)) const auto & get(index_t i) const {return data[i]; }
    inline __attribute__((host)) __attribute__((device)) constexpr const auto& operator[](index_t i) const { return get(i); }
    inline __attribute__((host)) __attribute__((device)) constexpr auto& operator[](index_t i) { return get(i); }
    inline __attribute__((host)) __attribute__((device)) constexpr auto& operator()(index_t i) { return get(i); }
    inline __attribute__((host)) __attribute__((device)) constexpr auto& at(index_t i) { return get(i); }
    inline __attribute__((host)) __attribute__((device)) constexpr const auto& at(index_t i) const { return get(i); }
    template <index_t I> inline __attribute__((host)) __attribute__((device)) constexpr auto& at() { return get(I); }
    template <index_t I> inline __attribute__((host)) __attribute__((device)) constexpr const auto& at() const { return get(I); }
    template <index_t I> inline __attribute__((host)) __attribute__((device)) constexpr auto& at(number<I>) { return get(I); }
    template <index_t I> inline __attribute__((host)) __attribute__((device)) constexpr const auto& at(number<I>) const { return get(I); }

    template <typename X_,
              typename std::enable_if<has_same_scalar_type<value_type, X_>::value, bool>::type = false>
    inline __attribute__((host)) __attribute__((device)) constexpr auto _get_as() const
    {
        using X = remove_cvref_t<X_>;

        constexpr index_t kSPerX = vector_traits<X>::vector_size;
        static_assert(N % kSPerX == 0);

        union {
            thread_buffer<X_, N / kSPerX> data {};

            value_type sub_data[N];
        } vx;
        static_for<0, N, 1>{}(
            [&](auto j) { vx.sub_data[j] = data[j]; });
        return vx.data;
    }

    template <typename X_,
              index_t Is,
              typename std::enable_if<has_same_scalar_type<value_type, X_>::value, bool>::type = false>
    inline __attribute__((host)) __attribute__((device)) const constexpr remove_reference_t<X_> _get_as(number<Is> is) const
    {
        using X = remove_cvref_t<X_>;

        constexpr index_t kSPerX = vector_traits<X>::vector_size;

        union {
            X_ data {};
            tuple_array<value_type, kSPerX> sub_data;
        } vx;
        static_for<0, kSPerX, 1>{}(
            [&](auto j) { vx.sub_data(j) = operator[]((is * number<sizeof(X_)/sizeof(value_type)>{}) + j); });
        return vx.data;
    }
