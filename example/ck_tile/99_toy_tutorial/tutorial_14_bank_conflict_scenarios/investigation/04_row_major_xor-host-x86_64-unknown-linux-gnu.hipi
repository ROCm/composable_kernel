    static_for<0, NSize, 1>{}([&](auto i) { r[i] = a * x[i]; });
    return r;
}


template <index_t NSize>
inline __attribute__((host)) __attribute__((device)) constexpr auto operator*(const multi_index<NSize>& x, index_t a)
{
    return a * x;
}

}
