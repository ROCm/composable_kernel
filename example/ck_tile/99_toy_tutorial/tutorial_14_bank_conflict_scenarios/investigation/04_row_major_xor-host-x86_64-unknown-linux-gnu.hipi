inline __attribute__((device)) uint32_t sad_u32(uint32_t x, uint32_t y, uint32_t acc)
{

    uint32_t res;
    asm volatile("v_sad_u32 %0, %1, %2, %3" : "=v"(res) : "v"(x), "v"(y), "v"(acc));
    return res;
}

inline __attribute__((host)) uint32_t sad_u32(uint32_t x, uint32_t y, uint32_t acc)
{
    return (x > y ? (x - y) : (y - x)) + acc;
}



