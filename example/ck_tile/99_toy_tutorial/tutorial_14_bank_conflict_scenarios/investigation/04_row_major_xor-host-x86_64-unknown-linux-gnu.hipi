inline __attribute__((host)) bool is_wave32()
{
    hipDeviceProp_tR0600 props{};
    int device;
    auto status = hipGetDevice(&device);
    if(status != hipSuccess)
    {
        return false;
    }
    status = hipGetDevicePropertiesR0600(&props, device);
    if(status != hipSuccess)
    {
        return false;
    }
    return props.major > 9;
}

