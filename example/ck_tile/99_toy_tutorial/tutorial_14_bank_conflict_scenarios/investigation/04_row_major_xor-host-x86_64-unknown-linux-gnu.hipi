    return static_cast<uint16_t>(bits >> 16) | (!(~bits & 0x7f800000) && (bits & 0xffff));
}


inline __attribute__((host)) __attribute__((device))
constexpr uint16_t float_to_bf16_truc_raw(float f)
{
