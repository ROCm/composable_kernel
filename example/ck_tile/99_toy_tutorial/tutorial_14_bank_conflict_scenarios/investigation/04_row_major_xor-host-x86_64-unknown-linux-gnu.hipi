namespace ck_tile {

static inline index_t get_available_compute_units(const stream_config& s)
{
    constexpr static uint32_t MAX_MASK_DWORDS = 64;


    uint32_t cu_mask[MAX_MASK_DWORDS]{};

    auto count_set_bits = [](uint32_t dword) {
        index_t count = 0;
        while(dword != 0)
        {
            if(dword & 0x1)
            {
                count++;
            }
            dword = dword >> 1;
        }
        return count;
    };

    do { hipError_t _tmpVal = hipExtStreamGetCUMask(s.stream_id_, MAX_MASK_DWORDS, &cu_mask[0]); if(_tmpVal != hipSuccess) { std::ostringstream ostr; ostr << "HIP Function Failed (" << "/data0/aghamari/composable_kernel/include/ck_tile/host/stream_utils.hpp" << "," << 34 << ") " << hipGetErrorString(_tmpVal); throw std::runtime_error(ostr.str()); } } while(0);

    index_t num_cu = 0;
    for(uint32_t i = 0; i < MAX_MASK_DWORDS; i++)
    {
        num_cu += count_set_bits(cu_mask[i]);
    }

    return num_cu;
};

}
