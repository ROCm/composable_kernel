namespace ck_tile {


template <typename key, typename data, index_t max_size = 128>
struct map
{
    using pair_type = tuple<key, data>;
    using impl_type = array<pair_type, max_size>;

    impl_type impl_;
    index_t size_;

    struct iterator
    {
        impl_type& impl_;
        index_t pos_;

        inline __attribute__((host)) __attribute__((device)) constexpr iterator(impl_type& impl, index_t pos)
            : impl_{impl}, pos_{pos}
        {
        }

        inline __attribute__((host)) __attribute__((device)) constexpr iterator& operator++()
        {
            pos_++;
            return *this;
        }

        inline __attribute__((host)) __attribute__((device)) constexpr bool operator!=(const iterator& other) const
        {
            return other.pos_ != pos_;
        }

        inline __attribute__((host)) __attribute__((device)) constexpr pair_type& operator*() { return impl_.at(pos_); }
    };

    struct const_iterator
    {
        const impl_type& impl_;
        index_t pos_;

        inline __attribute__((host)) __attribute__((device)) constexpr const_iterator(const impl_type& impl, index_t pos)
            : impl_{impl}, pos_{pos}
        {
        }

        inline __attribute__((host)) __attribute__((device)) constexpr const_iterator& operator++()
        {
            pos_++;

            return *this;
        }

        inline __attribute__((host)) __attribute__((device)) constexpr bool operator!=(const const_iterator& other) const
        {
            return other.pos_ != pos_;
        }

        inline __attribute__((host)) __attribute__((device)) constexpr const pair_type& operator*() const { return impl_.at(pos_); }
    };

    inline __attribute__((host)) __attribute__((device)) constexpr map() : impl_{}, size_{0} {}

    inline __attribute__((host)) __attribute__((device)) constexpr index_t size() const { return size_; }

    inline __attribute__((host)) __attribute__((device)) void clear() { size_ = 0; }

    inline __attribute__((host)) __attribute__((device)) constexpr index_t find_position(const key& k) const
    {
        for(index_t i = 0; i < size(); i++)
        {
            if(impl_[i].template at<0>() == k)
            {
                return i;
            }
        }

        return size_;
    }

    inline __attribute__((host)) __attribute__((device)) constexpr const_iterator find(const key& k) const
    {
        return const_iterator{impl_, find_position(k)};
    }

    inline __attribute__((host)) __attribute__((device)) constexpr iterator find(const key& k)
    {
        return iterator{impl_, find_position(k)};
    }

    inline __attribute__((host)) __attribute__((device)) constexpr const data& operator[](const key& k) const
    {
        const auto it = find(k);




        return impl_[it.pos_].template at<1>();
    }

    inline __attribute__((host)) __attribute__((device)) constexpr data& operator()(const key& k)
    {
        auto it = find(k);


        if(it.pos_ == size())
        {
            impl_(it.pos_).template at<0>() = k;
            size_++;
        }




        return impl_(it.pos_).template at<1>();
    }


    inline __attribute__((host)) __attribute__((device)) constexpr const_iterator begin() const { return const_iterator{impl_, 0}; }


    inline __attribute__((host)) __attribute__((device)) constexpr const_iterator end() const
    {
        return const_iterator{impl_, size_};
    }


    inline __attribute__((host)) __attribute__((device)) constexpr iterator begin() { return iterator{impl_, 0}; }


    inline __attribute__((host)) __attribute__((device)) constexpr iterator end() { return iterator{impl_, size_}; }
};

template <typename key, typename data, index_t max_size>
inline __attribute__((host)) __attribute__((device)) static void print(const map<key, data, max_size>& m)
{
    printf("map{size_: %d, impl_: [", m.size_);
    for(const auto& [k, d] : m)
    {
        printf("{key: ");
        print(k);
        printf(", data: ");
        print(d);
        printf("}, ");
    }
    printf("]}");
}

}
