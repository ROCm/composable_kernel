namespace ck_tile {



template <typename T>
inline __attribute__((host)) __attribute__((device)) void print(const T&)
{
    static_assert(sizeof(T) == 0,
                  "No print implementation available for this type. Please specialize "
                  "ck_tile::print for your type.");
}


template <>
inline __attribute__((host)) __attribute__((device)) void print(const int& value)
{
    printf("%d", value);
}


template <>
inline __attribute__((host)) __attribute__((device)) void print(const float& value)
{
    printf("%f", value);
}


template <>
inline __attribute__((host)) __attribute__((device)) void print(const double& value)
{
    printf("%f", value);
}


template <>
inline __attribute__((host)) __attribute__((device)) void print(const long& value)
{
    printf("%ld", value);
}


template <>
inline __attribute__((host)) __attribute__((device)) void print(const unsigned int& value)
{
    printf("%u", value);
}


template <>
inline __attribute__((host)) __attribute__((device)) void print(const char& value)
{
    printf("%c", value);
}


template <typename T, size_t N>
inline __attribute__((host)) __attribute__((device)) void print(const T (&value)[N])
{
    printf("[");
    for(size_t i = 0; i < N; ++i)
    {
        if(i > 0)
            printf(", ");
        print(value[i]);
    }
    printf("]");
}

}
