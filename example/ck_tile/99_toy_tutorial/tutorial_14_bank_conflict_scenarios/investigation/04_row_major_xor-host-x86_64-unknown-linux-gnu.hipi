    static constexpr index_t NumAccessPerCoord = load_store_traits::NumAccess / NumCoord;

    inline __attribute__((device)) constexpr tile_scatter_gather() = default;

    inline __attribute__((device)) constexpr tile_scatter_gather(const BottomTensorView& bottom_tensor_view,
                                                 const WindowLengths& window_lengths,
                                                 const BottomTensorIndex& window_origin,
                                                 const TileDstr& tile_distribution,
                                                 const PageIdxArray& page_idx,
