template <typename IndexingType>
struct indexing_adaptor_onshot_cached
{

    inline __attribute__((host)) __attribute__((device)) constexpr indexing_adaptor_onshot_cached() = default;
    inline __attribute__((host)) __attribute__((device)) constexpr indexing_adaptor_onshot_cached(const IndexingType& idx)
        : cached_idx_(idx)
    {
    }
    IndexingType cached_idx_;

    template <typename LowIdx, typename UpIdx>
    inline __attribute__((host)) __attribute__((device)) constexpr void calculate_lower_index(LowIdx& idx_low,
                                                             const UpIdx& ) const
    {
        static_assert(LowIdx::size() == 1 && UpIdx::size() == 1,
                      "wrong! inconsistent # of dimension");

        idx_low(number<0>{}) = cached_idx_;
    }

    template <typename LowIdxDiff, typename UpIdxDiff, typename LowIdx, typename UpIdx>
    inline __attribute__((host)) __attribute__((device)) void update_lower_index(LowIdxDiff& idx_diff_low,
                                                const UpIdxDiff& idx_diff_up,
                                                LowIdx& ,
                                                const UpIdx& ) const
    {

        static_assert(LowIdxDiff::size() == 1 && UpIdxDiff::size() == 1 && LowIdx::size() == 1 &&
                          UpIdx::size() == 1,
                      "wrong! inconsistent # of dimension");

        idx_diff_low(number<0>{}) = idx_diff_up[number<0>{}];


    }

    inline __attribute__((host)) __attribute__((device)) static constexpr bool is_known_at_compile_time()
    {
        return ck_tile::is_known_at_compile_time<IndexingType>::value;
    }
};
