namespace ck_tile {


struct pk_int4_t
{
    using type = int8_t;
    type data;
    inline __attribute__((host)) __attribute__((device)) constexpr pk_int4_t() : data{type{}} {}
    inline __attribute__((host)) __attribute__((device)) constexpr pk_int4_t(type init) : data{init} {}
};


template <class T>
struct numeric;

template <>
struct numeric<pk_int4_t>
{

    inline __attribute__((host)) __attribute__((device)) static constexpr pk_int4_t min()
    {
        constexpr uint8_t val = 0b10001000;
        return pk_int4_t(bit_cast<int8_t>(val));
    }


    inline __attribute__((host)) __attribute__((device)) static constexpr pk_int4_t lowest()
    {
        constexpr uint8_t val = 0b10001000;
        return pk_int4_t(bit_cast<int8_t>(val));
    }


    inline __attribute__((host)) __attribute__((device)) static constexpr pk_int4_t max()
    {
        constexpr uint8_t val = 0b01110111;
        return pk_int4_t(bit_cast<int8_t>(val));
    }


    inline __attribute__((host)) __attribute__((device)) static constexpr pk_int4_t epsilon()
    {
        return 1;
    }

    inline __attribute__((host)) __attribute__((device)) static constexpr pk_int4_t round_error()
    {
        return 1;
    }


    inline __attribute__((host)) __attribute__((device)) static constexpr pk_int4_t infinity()
    {
        return 1;
    }


    inline __attribute__((host)) __attribute__((device)) static constexpr pk_int4_t quiet_NaN()
    {
        return 1;
    }


    inline __attribute__((host)) __attribute__((device)) static constexpr pk_int4_t signaling_NaN()
    {
        return 1;
    }


    inline __attribute__((host)) __attribute__((device)) static constexpr pk_int4_t denorm_min()
    {
        return 1;
    }

    inline __attribute__((host)) __attribute__((device)) static constexpr pk_int4_t zero() { return 0; }
};

template <>
struct numeric_traits<pk_int4_t>
{
    static constexpr int PackedSize = 2;
};

using fp32x2_t = float __attribute__((ext_vector_type(2)));
using fp16x2_t = _Float16 __attribute__((ext_vector_type(2)));
using bf16x2_t = bfloat16_t __attribute__((ext_vector_type(2)));
using int8x2_t = int8_t __attribute__((ext_vector_type(2)));

inline __attribute__((host)) __attribute__((device)) fp32x2_t pk_int4_t_to_fp32x2_t(const pk_int4_t& x)
{
    uint8_t x_u8 = ck_tile::bit_cast<uint8_t>(x);

    float x_l = ((x_u8 & 0x0f) >> 0) - 8.f;
    float x_h = ((x_u8 & 0xf0) >> 4) - 8.f;


    fp32x2_t res = {x_h, x_l};



    return res;
}

inline __attribute__((host)) __attribute__((device)) fp32x2_t pk_int4_t_to_fp32x2_t_signed_conversion(const pk_int4_t& x)
{
    uint8_t x_u8 = ck_tile::bit_cast<uint8_t>(x);

    float x_l = ((x_u8 & 0x0f) >> 0);
    float x_h = ((x_u8 & 0xf0) >> 4);

    x_l = x_l > 7 ? x_l - 16 : x_l;
    x_h = x_h > 7 ? x_h - 16 : x_h;


    fp32x2_t res = {x_h, x_l};



    return res;
}

inline __attribute__((host)) __attribute__((device)) fp16x2_t pk_int4_t_to_halfx2_t(const pk_int4_t& x)
{
    uint8_t x_u8 = ck_tile::bit_cast<uint8_t>(x);

    uint32_t i4s = ((x_u8 & 0x0f) << 16) | ((x_u8 & 0xf0) >> 4);



    const int EX = 0x64006400;
    const int SUB = 0xE408E408;

    int lo = i4s | EX;

    return pk_add_f16(bit_cast<fp16x2_t>(lo), bit_cast<fp16x2_t>(SUB));
}

inline __attribute__((host)) __attribute__((device)) bf16x2_t pk_int4_t_to_bfloat16x2_t(const pk_int4_t& x)
{
    uint8_t x_u8 = ck_tile::bit_cast<uint8_t>(x);

    float x_l = ((x_u8 & 0x0f) >> 0) - 8.f;
    float x_h = ((x_u8 & 0xf0) >> 4) - 8.f;


    bf16x2_t res = {type_convert<bf16_t>(x_h), type_convert<bf16_t>(x_l)};



    return res;
}

inline __attribute__((host)) __attribute__((device)) int8x2_t pk_int4_t_to_int8x2_t(const pk_int4_t& x)
{
    uint8_t x_u8 = ck_tile::bit_cast<uint8_t>(x);

    int8_t x_l = (x_u8 & 0x0F);
    int8_t x_h = (x_u8 & 0xF0) >> 4;

    if(x_l & 0x08)
        x_l |= 0xF0;
    if(x_h & 0x08)
        x_h |= 0xF0;


    int8x2_t res = {x_h, x_l};



    return res;
}

}
