template <unsigned num_dwords, bool pre_nop = false>
inline __attribute__((device)) void async_buffer_load_dwordxn_v(void* smem,
                                                int32x4_t rsrc,
                                                index_t voffset,
                                                index_t ,
                                                index_t ioffset ,
                                                index_t = 0,
                                                bool_constant<pre_nop> = {})
{
# 1240 "/data0/aghamari/composable_kernel/include/ck_tile/core/arch/amd_buffer_addressing_builtins.hpp"
    if constexpr(num_dwords == 1)
    {
        if constexpr(pre_nop) asm volatile("s_nop 4\n" "buffer_load_dword" " %1, %2, 0 offen offset:%3 lds" : "=r"(smem) : "v"(voffset), "s"(rsrc), "n"(ioffset) : "memory"); else asm volatile("buffer_load_dword" " %1, %2, 0 offen offset:%3 lds" : "=r"(smem) : "v"(voffset), "s"(rsrc), "n"(ioffset) : "memory");;
    }
# 1254 "/data0/aghamari/composable_kernel/include/ck_tile/core/arch/amd_buffer_addressing_builtins.hpp"
    else
    {
        static_assert(false, "wrong! not implemented data width");
    }

}

