                                             sequence<Reduce{}(Y, sequence<Xs...>{}.back())>>::type;
    using type = typename sequence_exclusive_scan<old_scan, sequence<Ys...>, Reduce>::type;
};

template <index_t... Xs, index_t Y, typename Reduce>
