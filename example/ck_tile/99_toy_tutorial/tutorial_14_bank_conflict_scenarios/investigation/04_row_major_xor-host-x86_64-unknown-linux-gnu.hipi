template <typename TileWindowType_, typename BottomTensorView_, typename WindowLengths_>
struct tile_window_base
{

    using BottomTensorView = remove_reference_t<BottomTensorView_>;
    using WindowLengths = remove_cvref_t<WindowLengths_>;
    using BottomTensorDesc = typename BottomTensorView::TensorDesc;
    using DataType = remove_cvref_t<typename BottomTensorView::DataType>;

    static constexpr index_t NDimBottomTensor = BottomTensorDesc::get_num_of_dimension();

    static_assert(ck_tile::is_known_at_compile_time<WindowLengths>::value,
                  "wrong! lengths should be static");

    using BottomTensorIndex = array<index_t, NDimBottomTensor>;

    inline __attribute__((device)) constexpr auto get_window_origin() const { return window_origin_; }
    inline __attribute__((device)) constexpr auto get_window_lengths() const { return window_lengths_; }
    inline __attribute__((device)) constexpr auto get_bottom_tensor_view() const { return bottom_tensor_view_; }
    inline __attribute__((device)) static constexpr index_t get_num_of_dimension() { return NDimBottomTensor; }

    inline __attribute__((device)) void set_window_origin(const BottomTensorIndex& new_window_origin)
    {
        window_origin_ = new_window_origin;


        static_cast<TileWindowType_*>(this)->set_window_origin_extended(new_window_origin);
    }

    inline __attribute__((device)) void set_window_origin_extended(const BottomTensorIndex&) {}

    inline __attribute__((device)) constexpr void
    set_bottom_tensor_view_data_ptr(typename BottomTensorView::DataType* data)
    {
        bottom_tensor_view_.buf_.p_data_ = data;
    }


    inline __attribute__((device)) void move(const BottomTensorIndex& step)
    {
        window_origin_ += step;


        static_cast<TileWindowType_*>(this)->move_extended(step);
    }


    inline __attribute__((device)) void move_extended(const BottomTensorIndex&) {}


    BottomTensorIndex window_origin_;

    WindowLengths window_lengths_;



    BottomTensorView bottom_tensor_view_;
};

