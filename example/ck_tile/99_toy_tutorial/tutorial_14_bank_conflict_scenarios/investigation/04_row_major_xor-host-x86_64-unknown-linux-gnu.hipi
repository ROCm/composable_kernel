struct e8m0_bexp_t
{
    using raw_type = uint8_t;
    using type = raw_type;

    raw_type data;

    inline __attribute__((host)) __attribute__((device)) constexpr e8m0_bexp_t() : data{type{0b11111111}} {}
    inline __attribute__((host)) __attribute__((device)) explicit constexpr e8m0_bexp_t(type init) : data{init} {}
    inline __attribute__((host)) __attribute__((device)) explicit constexpr e8m0_bexp_t(float scale)
        : e8m0_bexp_t(static_cast<type>(numeric_utils<float>::get_exponent(scale)))
    {
    }
    inline __attribute__((host)) __attribute__((device)) constexpr operator type() const { return data; }
    inline __attribute__((host)) __attribute__((device)) constexpr raw_type& get() { return data; }
    inline __attribute__((host)) __attribute__((device)) constexpr raw_type get() const { return data; }
    inline __attribute__((host)) __attribute__((device)) constexpr operator float() const;

    constexpr bool operator==(const e8m0_bexp_t& other) const { return data == other.data; }

    constexpr bool operator!=(const e8m0_bexp_t& other) const { return data != other.data; }
};

using e8m0_t = e8m0_bexp_t;
using e8m0_raw_t = typename e8m0_t::raw_type;

template <>
struct numeric_traits<e8m0_t>
{
    using bitwise_type = e8m0_raw_t;

    static constexpr int exp = 8;
    static constexpr int mant = 0;
    static constexpr int bias = 127;
    static constexpr int PackedSize = 1;
};


template <class T>
struct numeric;

template <>
struct numeric<e8m0_t>
{
    static constexpr e8m0_raw_t binary_min = 0b00000000;
    static constexpr e8m0_raw_t binary_max = 0b11111110;
    static constexpr e8m0_raw_t binary_nan = 0b11111111;
    inline __attribute__((host)) __attribute__((device)) static constexpr e8m0_t min() { return e8m0_t{binary_min}; }
    inline __attribute__((host)) __attribute__((device)) static constexpr e8m0_t max() { return e8m0_t{binary_max}; }
    inline __attribute__((host)) __attribute__((device)) static constexpr e8m0_t quiet_NaN() { return e8m0_t{binary_nan}; }
    inline __attribute__((host)) __attribute__((device)) static constexpr e8m0_t signaling_NaN() { return e8m0_t{binary_nan}; }
    inline __attribute__((host)) __attribute__((device)) static constexpr bool has_inf() { return false; }

    inline __attribute__((host)) __attribute__((device)) static constexpr e8m0_t epsilon() { return signaling_NaN(); }
    inline __attribute__((host)) __attribute__((device)) static constexpr e8m0_t round_error() { return signaling_NaN(); }
    inline __attribute__((host)) __attribute__((device)) static constexpr e8m0_t zero() { return signaling_NaN(); }
    inline __attribute__((host)) __attribute__((device)) static constexpr e8m0_t infinity() { return signaling_NaN(); }
};

inline __attribute__((host)) __attribute__((device)) constexpr e8m0_bexp_t::operator float() const
{
    using traits = numeric_traits<float>;
    if(data == numeric<e8m0_t>::binary_nan)
    {
        return std::numeric_limits<float>::signaling_NaN();
    }
    else if(data == 0)
    {
        return std::numeric_limits<float>::min();
    }
    else
    {
        return bit_cast<float>(static_cast<traits::bitwise_type>(data) << traits::mant);
    }
}

