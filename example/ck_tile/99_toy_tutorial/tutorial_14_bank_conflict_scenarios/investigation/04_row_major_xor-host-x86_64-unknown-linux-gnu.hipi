namespace ck_tile {


template <typename T, uint32_t seed_>
struct prand_generator_t
{
    inline __attribute__((host)) __attribute__((device)) uint32_t operator()(int, T, uint32_t = seed_) { return 0; }
};


template <uint32_t seed_>
struct prand_generator_t<float, seed_>
{
    inline __attribute__((host)) __attribute__((device)) uint32_t operator()(int id, float val, uint32_t seed = seed_)
    {
        uint32_t x = bit_cast<uint32_t>(val);
        uint32_t drop_bits = uint32_t(x) & 0xFFFFu;
        drop_bits ^= x >> 16;
        drop_bits = ((drop_bits & 31) << 11) | (drop_bits >> 5);
        drop_bits *= 0x7000149;



        uint32_t rng = (drop_bits ^ 0x13371337 ^ (id * 229791) ^ seed);
        return rng;
    }
};


template <uint32_t seed_>
struct prand_generator_t<half_t, seed_>
{
    inline __attribute__((host)) __attribute__((device)) uint32_t operator()(int id, half_t val, uint32_t seed = seed_)
    {
        uint16_t x = bit_cast<uint16_t>(val);
        uint32_t drop_bits = uint32_t(x) & 0xFFFFu;
        drop_bits = ((drop_bits & 31) << 11) | (drop_bits >> 5);
        drop_bits *= 0x7000149;



        uint32_t rng = (drop_bits ^ 0x13371337 ^ (id * 229791) ^ seed);
        return rng;
    }
};

