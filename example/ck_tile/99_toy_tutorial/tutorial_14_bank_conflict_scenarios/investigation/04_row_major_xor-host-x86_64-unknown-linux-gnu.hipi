          typename PREFIX = str_literal<>,
          typename SUFFIX = str_literal<>>
struct CK_PRINTF;
template <typename ConvertTo, char... FMTChars, char... PREFIXChars, char... SUFFIXChars>
struct CK_PRINTF<ConvertTo,
                 str_literal<FMTChars...>,
                 str_literal<PREFIXChars...>,
                 str_literal<SUFFIXChars...>>
{
    template <typename T>
    inline __attribute__((host)) __attribute__((device)) static constexpr auto default_format()
    {
        if constexpr(std::is_same_v<T, float>)
            return std::apply([](auto... indices) { return str_literal<("%8.3f")[decltype(indices)::value]...>{}; }, makeTuple(std::make_index_sequence<constexpr_strlen("%8.3f")>()));
        else if constexpr(std::is_same_v<T, int>)
            return std::apply([](auto... indices) { return str_literal<("%5d")[decltype(indices)::value]...>{}; }, makeTuple(std::make_index_sequence<constexpr_strlen("%5d")>()));
        else if constexpr(std::is_same_v<T, unsigned int>)
            return std::apply([](auto... indices) { return str_literal<("%5u")[decltype(indices)::value]...>{}; }, makeTuple(std::make_index_sequence<constexpr_strlen("%5u")>()));
        else
            return std::apply([](auto... indices) { return str_literal<("0x%08x")[decltype(indices)::value]...>{}; }, makeTuple(std::make_index_sequence<constexpr_strlen("0x%08x")>()));
    }

    inline __attribute__((host)) __attribute__((device)) static constexpr auto get_prefix()
    {
        constexpr auto fmt_tid = std::apply([](auto... indices) { return str_literal<("tid %03d: [%02d] ")[decltype(indices)::value]...>{}; }, makeTuple(std::make_index_sequence<constexpr_strlen("tid %03d: [%02d] ")>()));
        if constexpr(sizeof...(PREFIXChars) == 0)
            return fmt_tid;
        else
            return fmt_tid + std::apply([](auto... indices) { return str_literal<(" ")[decltype(indices)::value]...>{}; }, makeTuple(std::make_index_sequence<constexpr_strlen(" ")>())) + str_literal<PREFIXChars...>{};
    }
    inline __attribute__((host)) __attribute__((device)) static constexpr auto get_suffix()
    {
        constexpr auto lf = std::apply([](auto... indices) { return str_literal<("\n")[decltype(indices)::value]...>{}; }, makeTuple(std::make_index_sequence<constexpr_strlen("\n")>()));
        if constexpr(sizeof...(SUFFIXChars) == 0)
            return lf;
        else
            return str_literal<SUFFIXChars...>{} + lf;
    }

    template <typename T, index_t N, typename Y, index_t... Is>
    inline __attribute__((host)) __attribute__((device)) void impl(const thread_buffer<T, N>& buf,
                                  std::integer_sequence<index_t, Is...>) const
    {
        using FMT1 = std::conditional_t<sizeof...(FMTChars) == 0,
                                                       decltype(default_format<Y>()),
                                                       str_literal<FMTChars...>>;
        constexpr auto fmt_v = FMT1::template duplicate_n<N>(std::apply([](auto... indices) { return str_literal<(" ")[decltype(indices)::value]...>{}; }, makeTuple(std::make_index_sequence<constexpr_strlen(" ")>())));
        constexpr auto fmt_wrap_v = get_prefix() + fmt_v + get_suffix();

#pragma clang diagnostic push
#pragma clang diagnostic ignored "-Wformat-nonliteral"
        printf(fmt_wrap_v.data, get_thread_id(), N, type_convert<Y>(buf[Is])...);
#pragma clang diagnostic pop
    }

    template <typename T, index_t N>
    inline __attribute__((host)) __attribute__((device)) void operator()(const thread_buffer<T, N>& buf) const
    {
        using ConvertTo_ = std::conditional_t<std::is_same_v<ConvertTo, void>, T, ConvertTo>;
        impl<T, N, ConvertTo_>(buf, std::make_integer_sequence<index_t, N>{});
    }

    template <typename... TS>
    inline __attribute__((host)) __attribute__((device)) void operator()(const static_distributed_tensor<TS...>& tensor) const
    {
        return operator()(tensor.get_thread_buffer());
    }
};

template <typename ConvertTo = void,
          typename FMT = str_literal<>,
          typename PREFIX = str_literal<>,
          typename SUFFIX = str_literal<>>
struct CK_PRINTF_WARP0 : public CK_PRINTF<ConvertTo, FMT, PREFIX, SUFFIX>
{
    using base_t = CK_PRINTF<ConvertTo, FMT, PREFIX, SUFFIX>;

    template <typename T>
    inline __attribute__((host)) __attribute__((device)) void operator()(const T& buf) const
    {
        if(get_thread_id() < get_warp_size())
            base_t::operator()(buf);
    }
};
