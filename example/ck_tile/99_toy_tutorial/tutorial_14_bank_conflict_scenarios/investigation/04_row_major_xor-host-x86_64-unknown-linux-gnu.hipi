    (static_cast <bool> (sorted_expert_ids_host.get_num_of_dimension() == 1) ? void (0) : __assert_fail ("sorted_expert_ids_host.get_num_of_dimension() == 1", "/data0/aghamari/composable_kernel/include/ck_tile/host/reference/reference_fused_moe.hpp", 82, __extension__ __PRETTY_FUNCTION__));
