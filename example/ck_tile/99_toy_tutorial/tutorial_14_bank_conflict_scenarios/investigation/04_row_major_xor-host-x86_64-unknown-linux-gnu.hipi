template <auto v>
struct constant
{
    using value_type = decltype(v);
    using type = constant;
    static constexpr value_type value = v;
    inline __attribute__((host)) __attribute__((device)) constexpr operator value_type() const noexcept { return value; }
    inline __attribute__((host)) __attribute__((device)) constexpr value_type operator()() const noexcept { return value; }
    inline __attribute__((host)) __attribute__((device)) static constexpr bool is_static() { return true; }
};

