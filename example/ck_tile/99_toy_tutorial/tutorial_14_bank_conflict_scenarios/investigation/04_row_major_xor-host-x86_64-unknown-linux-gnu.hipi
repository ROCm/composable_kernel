template <typename DataType, typename IndexType = index_t>
inline __attribute__((host)) auto reference_topk(const HostTensor<DataType>& x,
                                 index_t k,
                                 index_t dim = -1,
                                 bool largest = true,
                                 bool sorted = true)
{
