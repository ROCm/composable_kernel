    vector_res.x = x.x + y.x;
    vector_res.y = x.y + y.y;

    return vector_res;
}

inline __attribute__((device)) fp16x2_t pk_add_f16(const fp16x2_t& x, const fp16x2_t& y)
{
    fp16x2_t c;
    asm volatile("v_pk_add_f16 %0, %1, %2" : "=v"(c) : "v"(x), "v"(y));
    return c;
}

