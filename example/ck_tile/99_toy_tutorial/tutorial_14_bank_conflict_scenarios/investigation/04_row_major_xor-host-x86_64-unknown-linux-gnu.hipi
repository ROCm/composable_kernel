template <typename Seq, typename Reduce, index_t Init>
inline __attribute__((host)) __attribute__((device)) constexpr index_t
reduce_on_sequence(Seq, Reduce f, number<Init> )
{
    index_t result = Init;

    for(index_t i = 0; i < Seq::size(); ++i)
    {
        result = f(result, Seq::at(i));
    }

    return result;
}


template <typename Seq, typename F>
inline __attribute__((host)) __attribute__((device)) constexpr bool sequence_any_of(Seq, F f)
{
    bool flag = false;

    for(index_t i = 0; i < Seq::size(); ++i)
    {
        flag = flag || f(Seq::at(i));
    }

    return flag;
}


template <typename Seq, typename F>
inline __attribute__((host)) __attribute__((device)) constexpr bool sequence_all_of(Seq, F f)
{
    bool flag = true;

    for(index_t i = 0; i < Seq::size(); ++i)
    {
        flag = flag && f(Seq::at(i));
    }

    return flag;
}

