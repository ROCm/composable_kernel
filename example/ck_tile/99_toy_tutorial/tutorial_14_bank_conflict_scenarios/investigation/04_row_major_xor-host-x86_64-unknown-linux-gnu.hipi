namespace ck_tile {


template <typename WindowLengths_>
struct null_tile_window
{
    using BottomTensorView = null_tensor_view;
    using WindowLengths = remove_cvref_t<WindowLengths_>;

    using BottomTensorIndex = array<index_t, WindowLengths::size()>;

    inline __attribute__((device)) constexpr null_tile_window() = default;

    inline __attribute__((device)) constexpr null_tile_window(const WindowLengths& window_lengths)
        : window_lengths_{window_lengths}
    {
    }

    inline __attribute__((device)) constexpr auto get_window_lengths() const { return window_lengths_; }

    inline __attribute__((device)) constexpr auto get_bottom_tensor_view() const { return null_tensor_view{}; }

    inline __attribute__((device)) constexpr auto get_window_origin() const { return BottomTensorIndex{}; }

    inline __attribute__((device)) void init_raw() {}

    WindowLengths window_lengths_;
};


namespace impl {
template <typename>
struct is_null_tile_window : public std::false_type
{
};

template <typename T>
struct is_null_tile_window<null_tile_window<T>> : public std::true_type
{
};
}

template <typename T>
constexpr bool is_null_tile_window_v = impl::is_null_tile_window<remove_cvref_t<T>>::value;

template <typename T>
inline __attribute__((device)) constexpr auto is_null_tile_window(const T&)
{
    return is_null_tile_window_v<remove_cvref_t<T>>;
}

template <typename WindowLengths>
inline __attribute__((device)) constexpr auto make_null_tile_window(const WindowLengths& window_lengths)
{
    static_assert(ck_tile::is_known_at_compile_time<WindowLengths>::value,
                  "wrong! lengths should be static");

    return null_tile_window<remove_cvref_t<WindowLengths>>{window_lengths};
}

template <typename WindowLengths, typename... Ts>
inline __attribute__((device)) constexpr auto make_tile_window(null_tensor_view,
                                               const WindowLengths& window_lengths,
                                               const multi_index<WindowLengths::size()>& ,
                                               Ts&&...)
{
    static_assert(ck_tile::is_known_at_compile_time<WindowLengths>::value,
                  "wrong! lengths should be static");

    return null_tile_window<remove_cvref_t<WindowLengths>>{window_lengths};
}

template <typename WindowLengths, typename StaticTileDistribution>
inline __attribute__((device)) constexpr auto make_tile_window(const null_tile_window<WindowLengths>& t,
                                               const StaticTileDistribution&)
{
    return t;
}

template <typename WindowLengths>
inline __attribute__((device)) void
move_tile_window(null_tile_window<WindowLengths>&,
                 const typename null_tile_window<WindowLengths>::BottomTensorIndex&)
{
}

}
