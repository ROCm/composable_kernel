template <typename T_, index_t N_>
struct array
{
    using value_type = T_;
    static constexpr index_t N = N_;



    value_type data[N];


    inline __attribute__((host)) __attribute__((device)) constexpr array() : data{} {}


    inline __attribute__((host)) __attribute__((device)) constexpr array(std::initializer_list<value_type> ilist)
    {
        constexpr index_t list_size = std::initializer_list<value_type>{}.size();
        static_assert(list_size <= N, "out of bound");

        index_t i = 0;
        value_type vlast = value_type{};

        for(const value_type& val : ilist)
        {
            data[i] = val;
            vlast = val;
            ++i;
        }
        for(; i < N; ++i)
        {
            data[i] = vlast;
        }
    }

    template <typename Y,
              typename = std::enable_if_t<std::is_convertible_v<Y, value_type> ||
                                          std::is_constructible_v<Y, value_type>>>
    inline __attribute__((host)) __attribute__((device)) explicit constexpr array(Y c)
    {
        for(auto i = 0; i < size(); i++)
            data[i] = static_cast<value_type>(c);
    }
