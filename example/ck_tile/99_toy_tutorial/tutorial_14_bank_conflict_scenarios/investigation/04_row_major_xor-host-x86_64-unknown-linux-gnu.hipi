template <typename T>
struct maximize
{
    inline __attribute__((host)) __attribute__((device)) constexpr T operator()(T a, T b) const { return a >= b ? a : b; }
};

template <typename T>
struct minimize
{
    inline __attribute__((host)) __attribute__((device)) constexpr T operator()(T a, T b) const { return a <= b ? a : b; }
};

template <typename T>
struct integer_divide_ceiler
{
    inline __attribute__((host)) __attribute__((device)) constexpr T operator()(T a, T b) const
    {
        static_assert(std::is_same<T, index_t>{} || std::is_same<T, int>{}, "wrong type");
        return (a + b - number<1>{}) / b;
    }
};

template <typename X, typename Y>
inline __attribute__((host)) __attribute__((device)) constexpr auto integer_divide_floor(X x, Y y)
{
    return x / y;
}

template <typename X, typename Y>
inline __attribute__((host)) __attribute__((device)) constexpr auto integer_divide_ceil(X x, Y y)
{
    return (x + y - number<1>{}) / y;
}

template <typename X, typename Y>
inline __attribute__((host)) __attribute__((device)) constexpr auto integer_least_multiple(X x, Y y)
{
    return y * integer_divide_ceil(x, y);
}

template <typename T>
inline __attribute__((host)) __attribute__((device)) constexpr T max(T x)
{
    return x;
}

template <typename T>
inline __attribute__((host)) constexpr T max(T x, T y)
{
    return x > y ? x : y;
}

template <typename T>
inline __attribute__((device)) constexpr T max(T x, T y)
{
    return x > y ? x : y;
}

template <>
inline __attribute__((device)) constexpr float max(float x, float y)
{
    return __builtin_fmaxf(x, y);
}

template <>
inline __attribute__((device)) constexpr double max(double x, double y)
{
    return __builtin_fmax(x, y);
}

template <index_t X>
inline __attribute__((host)) __attribute__((device)) constexpr index_t max(number<X>, index_t y)
{
    return X > y ? X : y;
}

template <index_t Y>
inline __attribute__((host)) __attribute__((device)) constexpr index_t max(index_t x, number<Y>)
{
    return x > Y ? x : Y;
}

template <typename X, typename... Ys>
inline __attribute__((host)) __attribute__((device)) constexpr auto max(X x, Ys... ys)
{
    static_assert(sizeof...(Ys) > 0, "not enough argument");
    return max(x, max(ys...));
}

template <typename T>
inline __attribute__((host)) __attribute__((device)) constexpr T min(T x)
{
    return x;
}

template <typename T>
inline __attribute__((host)) constexpr T min(T x, T y)
{
    return x < y ? x : y;
}

template <typename T>
inline __attribute__((device)) constexpr T min(T x, T y)
{
    return x < y ? x : y;
}

template <>
inline __attribute__((device)) constexpr float min(float x, float y)
{
    return __builtin_fminf(x, y);
}

template <>
inline __attribute__((device)) constexpr double min(double x, double y)
{
    return __builtin_fmin(x, y);
}

template <index_t X>
inline __attribute__((host)) __attribute__((device)) constexpr index_t min(number<X>, index_t y)
{
    return X < y ? X : y;
}

template <index_t Y>
inline __attribute__((host)) __attribute__((device)) constexpr index_t min(index_t x, number<Y>)
{
    return x < Y ? x : Y;
}

template <typename X, typename... Ys>
inline __attribute__((host)) __attribute__((device)) constexpr auto min(X x, Ys... ys)
{
    static_assert(sizeof...(Ys) > 0, "not enough argument");
    return min(x, min(ys...));
}

template <typename T>
inline __attribute__((host)) __attribute__((device)) constexpr T clamp(const T& x, const T& lowerbound, const T& upperbound)
{
    return min(max(x, lowerbound), upperbound);
}

