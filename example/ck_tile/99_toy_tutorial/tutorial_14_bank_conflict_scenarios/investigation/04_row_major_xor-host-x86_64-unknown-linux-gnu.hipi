struct Relu
{
    static constexpr const char* name = "Relu";

    template <typename T>
    inline __attribute__((host)) __attribute__((device)) void operator()(T& y, const T& x) const
    {
        static_assert(std::is_same_v<T, float> || std::is_same_v<T, double> ||
                          std::is_same_v<T, ck_tile::fp16_t> || std::is_same_v<T, int32_t> ||
                          std::is_same_v<T, int8_t>,
                      "Data type is not supported by this operation!");
        y = x > 0 ? x : 0;
    }

    template <>
    inline __attribute__((host)) __attribute__((device)) void operator()(ck_tile::bf16_t& y, const ck_tile::bf16_t& x) const
    {
        float x_f32 = ck_tile::type_convert<float>(x);
        float y_f32 = x_f32 > 0 ? x_f32 : 0;
        y = ck_tile::type_convert<ck_tile::bf16_t>(y_f32);
    }
};






struct FastGelu
{
    static constexpr const char* name = "FastGelu";

    template <typename Y, typename X>
    inline __attribute__((host)) void operator()(Y& y, const X& x) const;

    template <typename Y, typename X>
    inline __attribute__((device)) void operator()(Y& y, const X& x) const;

    template <>
    inline __attribute__((host)) void operator()<float, float>(float& y, const float& x) const
    {

        const float c1 = -2.0 * 0.035677f;
        const float c2 = -2.0 * 0.797885f;
        const float u = x * (c1 * x * x + c2);
        const float emu = exp(u);
        y = x / (1.f + emu);
    }


    template <>
    inline __attribute__((device)) void operator()<float, float>(float& y, const float& x) const
    {

        const float c1 = -2.0 * 0.035677f;
        const float c2 = -2.0 * 0.797885f;
        const float u = x * (c1 * x * x + c2);
        const float emu = __ocml_exp_f32(u);

        y = x * ck_tile::rcp(1.f + emu);
    }

    template <>
    inline __attribute__((host)) void operator()<ck_tile::fp16_t, ck_tile::fp16_t>(ck_tile::fp16_t& y,
                                                                   const ck_tile::fp16_t& x) const
    {
        float y_f;

        this->operator()<float, float>(y_f, type_convert<float>(x));

