template <fp8_rounding_mode rounding>
inline __attribute__((host)) __attribute__((device)) fp8_raw_t float_to_fp8_raw(float x, constant<rounding>)
{
    if constexpr(rounding == fp8_rounding_mode::standard)
    {
        return float_to_fp8_rtn_raw<float, fp8_t>(x);
    }
    else if constexpr(rounding == fp8_rounding_mode::stochastic)
    {
        return float_to_fp8_sr_raw<float, fp8_t>(x);
    }
    else
    {
        return fp8_raw_t{0};
    }
}

template <fp8_rounding_mode rounding>
inline __attribute__((host)) __attribute__((device)) bf8_raw_t float_to_bf8_raw(float x, constant<rounding>)
{
