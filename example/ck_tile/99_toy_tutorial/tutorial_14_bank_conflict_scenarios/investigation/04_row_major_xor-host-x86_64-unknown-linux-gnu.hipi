# 11 "/data0/aghamari/composable_kernel/include/ck_tile/core/container/span.hpp"
namespace ck_tile {




template <typename T>
class span
{
    public:
    using element_type = T;
    using value_type = std::remove_cv_t<element_type>;
    using size_type = std::size_t;
    using difference_type = std::ptrdiff_t;
    using pointer = element_type*;
    using const_pointer = const element_type*;
    using reference = element_type&;
    using const_reference = const element_type&;
    using iterator = pointer;
    using const_iterator = pointer;

    inline __attribute__((host)) __attribute__((device)) constexpr span() : span(nullptr, size_type{0}) {}

    inline __attribute__((host)) __attribute__((device)) constexpr span(pointer first, size_type count) : ptr_(first), size_(count)
    {
    }

    inline __attribute__((host)) __attribute__((device)) constexpr span(pointer first, pointer last) : span(first, last - first) {}

    template <std::size_t N>
    inline __attribute__((host)) __attribute__((device)) constexpr span(element_type (&arr)[N]) noexcept : span(arr, N)
    {
    }

    template <std::size_t N>
    inline __attribute__((host)) __attribute__((device)) constexpr span(std::array<value_type, N>& arr) noexcept
        : span(arr.data(), N)
    {
    }

    template <typename Container>
    inline __attribute__((host)) __attribute__((device)) constexpr span(const Container& container)
        : span(container.data(), container.size())
    {
    }

    inline __attribute__((host)) __attribute__((device)) constexpr iterator begin() const noexcept { return ptr_; }
    inline __attribute__((host)) __attribute__((device)) constexpr const_iterator cbegin() const noexcept { return begin(); }

    inline __attribute__((host)) __attribute__((device)) constexpr iterator end() const noexcept { return begin() + size(); }
    inline __attribute__((host)) __attribute__((device)) constexpr const_iterator cend() const noexcept { return end(); }

    inline __attribute__((host)) __attribute__((device)) constexpr reference front() const { return *begin(); }
    inline __attribute__((host)) __attribute__((device)) constexpr reference back() const { return *(--end()); }

    inline __attribute__((host)) __attribute__((device)) constexpr reference operator[](size_type idx) const
    {
        return *(begin() + idx);
    }
    inline __attribute__((host)) __attribute__((device)) constexpr pointer data() const noexcept { return ptr_; }

    inline __attribute__((host)) __attribute__((device)) constexpr size_type size() const noexcept { return size_; }

    private:
    pointer ptr_;
    size_type size_;
};

}
