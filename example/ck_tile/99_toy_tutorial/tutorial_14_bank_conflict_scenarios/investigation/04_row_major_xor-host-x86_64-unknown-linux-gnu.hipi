# 1 "/data0/aghamari/composable_kernel/include/ck_tile/core/arch/workgroup_barrier.hpp" 1








namespace ck_tile {

struct workgroup_barrier
{
    inline __attribute__((device)) workgroup_barrier(uint32_t* ptr) : base_ptr(ptr) {}

    inline __attribute__((device)) uint32_t ld(uint32_t offset = 0)
    {
        return __atomic_load_n(base_ptr + offset, 0);
    }

    inline __attribute__((device)) void wait_eq(uint32_t value, uint32_t offset = 0)
    {
        if(threadIdx.x == 0)
        {
            while(ld(offset) != value) {}
        }
        __syncthreads();
    }

    inline __attribute__((device)) void wait_lt(uint32_t value, uint32_t offset = 0)
    {
        if(threadIdx.x == 0)
        {
            while(ld(offset) < value) {}
        }
        __syncthreads();
    }

    inline __attribute__((device)) void wait_set(uint32_t compare, uint32_t value, uint32_t offset = 0)
    {
        if(threadIdx.x == 0)
        {
            while(atomicCAS(base_ptr + offset, compare, value) != compare) {}
        }
        __syncthreads();
    }


    inline __attribute__((device)) void aquire(uint32_t offset = 0) { wait_set(offset, 0, 1); }


    inline __attribute__((device)) void release(uint32_t offset = 0) { wait_set(offset, 1, 0); }

    inline __attribute__((device)) void inc(uint32_t offset = 0)
    {
        __syncthreads();
        if(threadIdx.x == 0)
        {
            atomicAdd(base_ptr + offset, 1);
        }
    }

    uint32_t* base_ptr;
};

}
