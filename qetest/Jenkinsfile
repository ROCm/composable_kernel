def rocmnode(name) {
    return '(rocmtest || miopen) && (' + name + ')'
}

// Given a pattern, check if the log contains the pattern.
def checkForPattern(pattern, log) {
    // Regex check for a match in the log.
    if (log ==~ pattern) {
        echo "Found match in log for ${pattern}"
        return true;
    } else {
        echo "No match found in log for ${pattern}"
        return false;
    }
}

pipeline {
    agent none
    parameters {
        booleanParam(
            name: "FORCE_CI",
            defaultValue: false,
            description: "Force CI to run even when only non-relevant files are changed (default: OFF)")
    }
    stages{
        stage("Determine CI Execution") {
            agent{ label rocmnode("nogpu") }
            steps {
                script {
                    env.SHOULD_RUN_CI = String.valueOf(params.FORCE_CI.toBoolean())
                    echo "SHOULD_RUN_CI: ${env.SHOULD_RUN_CI}"
                }
            }
        }
        stage("Locate Image Failure Example") {
            agent{ label rocmnode("nogpu") }
            steps {
                script {
                    echo "Unable to locate image"
                    echo "login attempt to https://some.docker.io/v2 failed with status: 401 Unauthorized"
                }
            }
        }
        stage("Checkout Failure Example") {
            agent{ label rocmnode("nogpu") }
            steps {
                script {
                    echo "Checkout failure example"
                    echo "Checkout failure ..."
                }
            }
        }
    }
    post {
        success {
            node(rocmnode("nogpu")) {
                script {
                    def buildLog = sh(script: 'wget -q --no-check-certificate -O - ' + BUILD_URL + 'consoleText', returnStdout: true)
                    def matchFound = checkForPattern("Checkout failure", buildLog)
                    echo "Match found? ${matchFound}"
                    withCredentials([string(credentialsId: 'ck_ci_errors_webhook_url', variable: 'WEBHOOK_URL')]) {
                        sh """
                            curl -X POST '${WEBHOOK_URL}' \
                            -H 'Content-Type: application/json' \
                            -d '{
                                "subject": "✅ Build Success",
                                "text": "successful build"
                            }'
                        """
                    }
                }
            }
        }
        failure {
            node(rocmnode("nogpu")) {
                script {
                    withCredentials([string(credentialsId: 'ck_ci_errors_webhook_url', variable: 'WEBHOOK_URL')]) {
                        sh """
                            curl -X POST '${WEBHOOK_URL}' \
                            -H 'Content-Type: application/json' \
                            -d '{
                                "subject": "❌ Build Failed",
                                "text": "Failed to build"
                            }'
                        """
                    }
                }
            }
        }
    }
}
