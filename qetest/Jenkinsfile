def rocmnode(name) {
    return '(rocmtest || miopen) && (' + name + ')'
}

def generateAndArchiveBuildTraceVisualization() {
    try {
    // Pull image
    def image = "ghcr.io/puppeteer/puppeteer:latest"
    echo "Pulling image: ${image}"
    def retimage = docker.image("${image}")
    retimage.pull()

    // Create a temporary workspace
    sh """#!/bin/bash
        mkdir -p workspace
        echo "Current directory:"
        pwd
        echo "Contents of current directory:"
        ls -la
        cp ./script/infra_helper/capture_build_trace.js ./workspace
        cp ./qetest/ck_build_trace_dummy_test.json ./workspace/ck_build_trace.json
        chmod +w -R ./workspace
        ls -la ./workspace
    """
    def dockerOpts = "--cap-add=SYS_ADMIN -v \"\$(pwd)/workspace:/workspace\" -e NODE_PATH=/home/pptruser/node_modules"
    
    // Run docker container directly
    sh """
        docker run --rm ${dockerOpts} ${image} node /workspace/capture_build_trace.js
        mv ./workspace/perfetto_snapshot.png ./workspace/perfetto_snapshot_build_${env.BUILD_NUMBER}.png
    """
    
    // Archive the snapshot
    archiveArtifacts "workspace/perfetto_snapshot_build_*.png"
    } catch (Exception e) {
        echo "Throwing error exception while generating build trace visualization"
        echo 'Exception occurred: ' + e.toString()
    }

    // Notify the channel
    withCredentials([string(credentialsId: 'ck_ci_errors_webhook_url', variable: 'WEBHOOK_URL')]) {
    sh '''
        # Convert image to base64
        IMAGE_BASE64=$(base64 -w 0 ./workspace/perfetto_snapshot_build_''' + env.BUILD_NUMBER + '''.png)
        
        curl -X POST "${WEBHOOK_URL}" \
        -H 'Content-Type: application/json' \
        -d "{
            \\"image\\": \\"$IMAGE_BASE64\\"
        }"
    '''
    }
}

pipeline {
    agent none
    stages{
        stage("Build Trace Visualization Test") {
            agent{ label rocmnode("nogpu") }
            steps {
                script {
                    generateAndArchiveBuildTraceVisualization();
                }
            }
        }
    }
}